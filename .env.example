# Copy to .env (repo root, read by Docker Compose) and fill in real values.
# Never commit .env.

# PostgreSQL (Silver / Gold)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# MinIO (Bronze object storage, S3-compatible)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_BRONZE=

# Airflow
# Your host user id (run `id -u`), so files written by containers are owned by you.
AIRFLOW_UID=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=

# Scryfall API
# Identify the app, e.g. "magic_cards_etl/0.1 (contact: you@example.com)".
SCRYFALL_USER_AGENT=
